# Kirklin's openclaw-pack - 环境变量配置示例
# 复制此文件为 .env 并按需修改相应的值

# ==========================================
# 1. 应用与基础架构配置 (APP_ 命名空间)
# ==========================================
# Docker 镜像名称
APP_IMAGE=kirklin/openclaw-pack:latest
# OpenClaw 数据持久化目录（替换宿主机对应路径）
APP_DATA_DIR=~/.openclaw
# 可选：容器启动用户 UID:GID，用于自愈修复挂载目录。
# 默认 0:0（root），自动修复后再降权为 node 启动服务。如不清楚请保持默认
APP_RUN_USER=0:0
# 是否全局启用插件体系 (true/false)
OPENCLAW_PLUGINS_ENABLED=true

# ==========================================
# 2. 网关系统配置 (Gateway 配置)
# ==========================================
# 网关鉴权 Token（最关键！用于你个人的系统外部请求）
OPENCLAW_GATEWAY_TOKEN=sk-kirklin-change-me
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_MODE=local
# 允许的 Origin 域，多个用逗号隔开 (建议包含 localhost:18789)
OPENCLAW_GATEWAY_ALLOWED_ORIGINS=http://localhost:18789,http://localhost
# 允许不安全认证（如 http），可选 true/false
OPENCLAW_GATEWAY_ALLOW_INSECURE_AUTH=true
# 危险：禁用设备认证（在 Docker 环境中由于宿主机环境变化，强烈建议设为 true 以免重复要求配对）
OPENCLAW_GATEWAY_DANGEROUSLY_DISABLE_DEVICE_AUTH=true

# ==========================================
# 3. 大模型代理配置 (LLM_ 命名空间)
# ==========================================
# 是否自动同步配置文件中的大模型选项? 若手动在 UI 改了配置请设为 false
LLM_AUTO_SYNC=true
# 主模型 ID，若有多个用逗号隔开，首个为默认
LLM_PRIMARY_MODEL=gpt-5-nano
# 图片分析视觉模型 ID (留空则同上)
LLM_VISION_MODEL=
# 大模型底座基地址
LLM_BASE_URL=https://api.openai.com/v1
# API 密钥
LLM_API_KEY=sk-xxxxxx
# API 协议类型: openai-completions 或 anthropic-messages
LLM_API_FORMAT=openai-completions
LLM_CTX_WINDOW=128000
LLM_MAX_TOKENS=8192

# (可选) 备用通道 2 配置
# LLM_SECONDARY_NAME=provider_2
# LLM_SECONDARY_MODEL_ID=claude-3-5
# LLM_SECONDARY_BASE_URL=https://api.anthropic.com
# LLM_SECONDARY_API_KEY=sk-ant-xxxx
# LLM_SECONDARY_PROTOCOL=anthropic-messages
# LLM_SECONDARY_CONTEXT_WINDOW=200000
# LLM_SECONDARY_MAX_TOKENS=8192

# (可选) Google Gemini 官方接入示例 配置
# 开启 Gemini 时，取消下方注释并填写 GEMINI_API_KEY 即可
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxx
# LLM_THIRD_NAME=google
# LLM_THIRD_MODEL_ID=google/gemini-3.1-flash-lite-preview
# LLM_THIRD_BASE_URL=https://generativelanguage.googleapis.com
# LLM_THIRD_PROTOCOL=google-gemini-api
# LLM_THIRD_CONTEXT_WINDOW=2000000
# LLM_THIRD_MAX_TOKENS=8192

# ==========================================
# 4. 机器人与 IM 通道凭证 (BOT_ 命名空间)
# ==========================================

# 飞书 (Feishu) 配置 （可选，留空则不启用）
BOT_FEISHU_APP_ID=
BOT_FEISHU_SECRET=

# 钉钉 (Dingtalk) 配置 （可选，留空则不启用）
BOT_DING_CLIENT_ID=
BOT_DING_SECRET=
BOT_DING_ROBOT_CODE=
BOT_DING_CORP_ID=
BOT_DING_AGENT_ID=

# QQ 与 Napcat (OneBot v11) 配置 （可选，留空则不启用）
BOT_QQ_APP_ID=
BOT_QQ_SECRET=
# 仅 Napcat 需要填写以下配置：
BOT_NAPCAT_WS_PORT=
BOT_NAPCAT_HTTP_URL=
BOT_NAPCAT_ACCESS_TOKEN=
BOT_NAPCAT_ADMINS=

# 企业微信 (WeCom) 配置 （可选，留空则不启用）
# 方式1：标准单账号 - 自动映射为 default Bot
BOT_WECOM_TOKEN=
BOT_WECOM_AES_KEY=
# 方式2：多账号聚合 (Multi-Bot) Json 字符串。支持分离式独立鉴权。与单账号二选一填写
# 示例：{"bot1":{"token":"t1","encodingAesKey":"k1","agent":{"corpId":"wwxxx","corpSecret":"s1","agentId":1000001}}}
BOT_WECOM_MULTI_JSON=

# Telegram 配置 （可选，留空则不启用）
BOT_TELEGRAM_TOKEN=

# ==========================================
# 5. OpenViking 长效记忆配置 (OPENVIKING_ 命名空间)
# ==========================================
# 是否启用 OpenViking 长效记忆插件 (true/false)
OPENVIKING_MEMORY_ENABLED=true

# ---- OpenViking 供应商配置 ----
# 统一 API Key / Base（当 embedding 和 VLM 用同一个供应商时，只需填这两项）
# 留空则自动复用上方的 LLM_API_KEY / LLM_BASE_URL
OV_API_KEY=
OV_API_BASE=

# Embedding 配置
# Provider 可选: openai（兼容任意 OpenAI 兼容中转）/ volcengine / jina
OPENVIKING_EMBED_PROVIDER=openai
# 模型名（OpenAI 兼容推荐: text-embedding-3-small / text-embedding-3-large）
OPENVIKING_EMBED_MODEL=text-embedding-3-small
# 向量维度（需与模型匹配，text-embedding-3-small=1536）
OPENVIKING_EMBED_DIM=1536
# 若 Embedding 和 VLM 使用不同 Key/Base，在此单独覆盖（留空则复用 OV_API_KEY/BASE）
# OPENVIKING_EMBED_API_KEY=
# OPENVIKING_EMBED_API_BASE=

# VLM 配置（用于理解图片/视频等多模态内容）
# Provider 可选: openai / volcengine / litellm
OPENVIKING_VLM_PROVIDER=openai
# 模型名（OpenAI 兼容推荐: gpt-4o / gpt-4o-mini）
OPENVIKING_VLM_MODEL=gpt-4o-mini
# 若 VLM 使用不同 Key/Base（留空则复用 OV_API_KEY/BASE）
# OPENVIKING_VLM_API_KEY=
# OPENVIKING_VLM_API_BASE=

# ---- OpenClaw 插件配置 ----
# OpenViking 服务连接地址（Docker Compose 内部默认，一般勿改）
OPENVIKING_BASE_URL=http://openviking:1933
# OpenViking 服务暴露给宿主机的端口（默认 1933，可选）
OPENVIKING_PORT=1933
# Agent 标识符（留空=容器启动时自动生成）
OPENVIKING_AGENT_ID=
# 是否自动回忆历史记忆 (true/false)
OPENVIKING_AUTO_RECALL=true
# 是否自动捕获并保存新记忆 (true/false)
OPENVIKING_AUTO_CAPTURE=true

# ==========================================
# 6. Tools 工具策略配置 (OPENCLAW_TOOLS_ 命名空间)
# ==========================================
# 工具 profile（基础权限集）: minimal | coding | messaging | full
# 默认 coding = group:fs + group:runtime + group:sessions + group:memory
OPENCLAW_TOOLS_PROFILE=coding

# 在 profile 基础上额外 allow 的工具（逗号分隔），默认启用 web/browser/image
# 容器内已安装 Playwright + Chromium，browser 工具可正常使用
OPENCLAW_TOOLS_ALLOW=group:web,browser,image

# 在 profile 基础上额外 deny 的工具（deny 优先级高于 allow）
# canvas/nodes 在纯服务器容器环境下无意义，默认禁用
OPENCLAW_TOOLS_DENY=canvas,nodes

# 是否开启 Agent 工具调用死循环检测 (true/false)
OPENCLAW_TOOLS_LOOP_DETECTION=true
